{
  "name": "device-information-manager",
  "version": "1.0.0",
  "private": true,
  "description": "Web application to view and maintain deviceInformation.json, with GitHub as the source of truth.",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite",
    "dev:server": "tsx watch --clear-screen=false server/index.ts",
    "build": "npm run typecheck && npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "vite build --ssr server/index.ts --outDir dist-server --emptyOutDir",
    "start": "node dist-server/index.js",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.server.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:pages": "vite --mode pages",
    "build:pages": "npm run typecheck && vite build --mode pages --outDir dist-pages --emptyOutDir",
    "preview:pages": "vite preview --mode pages --outDir dist-pages",
    "auth-helper": "tsx auth-helper/local.ts",
    "build:auth-helper": "vite build --ssr auth-helper/worker.ts --outDir dist-auth-helper --emptyOutDir"
  },
  "dependencies": {
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.3.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "concurrently": "^10.0.7",
    "framer-motion": "^14.14.0",
    "jsdom": "^31.0.1",
    "lucide-react": "^1.76.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "sonner": "^2.0.8",
    "supertest": "^7.3.2",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
