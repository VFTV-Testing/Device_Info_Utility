# Build settings for the static GitHub Pages site (`npm run build:pages`).
# Everything here is PUBLIC and compiled into the page — never put a token or secret here.
# Users sign in with their own GitHub token in the browser.
VITE_DATA_MODE=github-direct
VITE_GITHUB_OWNER=VFTV-Testing
VITE_GITHUB_REPO=Configs
VITE_GITHUB_BRANCH=Main
VITE_GITHUB_FILE_PATH=AVSB_GEN3_Configs/deviceInformation.json

# "Sign in with GitHub" (public values). Leave VITE_AUTH_HELPER_URL empty until the
# sign-in helper is deployed — the page then falls back to personal-token sign-in.
VITE_OAUTH_CLIENT_ID=Iv23lilHr5KvRr0f2Smp
VITE_AUTH_HELPER_URL=
