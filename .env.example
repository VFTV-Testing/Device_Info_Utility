# ─────────────────────────────────────────────────────────────────────────────
# Device Information Manager — server configuration
# Copy to `.env` (never commit `.env`) or set these as environment variables
# on your host. These values are read by the Node server ONLY; none of them are
# ever sent to the browser.
# ─────────────────────────────────────────────────────────────────────────────

# "github" (real use: reads/commits deviceInformation.json in GitHub)
# "local"  (development only: reads/writes a file on disk, no Git commits)
STORAGE_MODE=github

# HTTP port for the server (the Vite dev server proxies /api to this port)
PORT=3001

# ── GitHub target ────────────────────────────────────────────────────────────
GITHUB_OWNER=your-org-or-user
GITHUB_REPO=Device_Info_Utility
GITHUB_BRANCH=main
# Path of the JSON file inside the repository (nested paths are fine, e.g. data/deviceInformation.json)
GITHUB_FILE_PATH=deviceInformation.json
# Only change for GitHub Enterprise Server, e.g. https://github.example.com/api/v3
# GITHUB_API_URL=https://api.github.com

# ── GitHub authentication — choose ONE option ────────────────────────────────
# Option A (recommended): GitHub App installed on the repository with
#   Repository permissions → Contents: Read and write
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
# Either a path to the downloaded .pem file …
GITHUB_APP_PRIVATE_KEY_PATH=
# … or the key inline with \n for newlines (useful for hosting dashboards)
# GITHUB_APP_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----

# Option B: fine-grained personal access token limited to this one repository
#   Repository access → Only select repositories → this repo
#   Permissions → Contents: Read and write   (nothing else is needed)
# GITHUB_TOKEN=

# Optional: committer identity for commits (defaults to the App / token owner)
# GIT_COMMITTER_NAME=Device Information Manager
# GIT_COMMITTER_EMAIL=device-info-bot@example.com

# ── Local mode (STORAGE_MODE=local only) ─────────────────────────────────────
# LOCAL_DATA_FILE=deviceInformation.json

# ── Access control for the web app (optional but recommended) ───────────────
# When both are set, every page and API call requires HTTP Basic sign-in and the
# user name is recorded in commit messages. Always use HTTPS in production.
# For company SSO, leave these empty and put the app behind your SSO proxy.
# APP_BASIC_AUTH_USER=
# APP_BASIC_AUTH_PASSWORD=

# ── Static files ─────────────────────────────────────────────────────────────
# Directory with the built frontend (defaults to ./dist)
# STATIC_DIR=dist

# ── "Sign in with GitHub" helper, local test run (`npm run auth-helper`) ─────
# From your GitHub App: Client ID, and a generated Client secret (keep secret!)
# OAUTH_CLIENT_ID=
# OAUTH_CLIENT_SECRET=
# OAUTH_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:4321
